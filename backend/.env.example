# ==============================================================================
# Q.I. TECH - CONFIGURAÇÕES DO BACKEND (FASTAPI + BANCO DE DADOS)
# ==============================================================================

# BANCO DE DADOS:
# Para usar o Supabase PostgreSQL:
# Obtenha sua Connection String no Supabase em Project Settings > Database > Connection String (URI / Session Mode Pooler):
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Para contingência local SQLite:
DATABASE_URL=sqlite:///./qi_matchmaker.db

# AMBIENTE E SEGREDO
APP_ENV=development
SECRET_KEY=qitech_secret_token_chave_privada_local_dev_123456789

# MODELOS DE IA LOCAIS
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
