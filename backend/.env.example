# Q.I. Tech Matchmaker Engine Configuration
APP_NAME="Q.I. Tech Matchmaker Engine"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default for zero-config local run; PostgreSQL supported)
DATABASE_URL=sqlite:///./qi_matchmaker.db

# Model 1: Faster-Whisper (Audio Transcription)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt

# Model 2: LLM Extraction (Ollama / Qwen3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60

# Model 3: Semantic Representations
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Matching Weights Heuristics
WEIGHT_HARD_SKILLS=0.50
WEIGHT_SOFT_SKILLS=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_CONDITIONS=0.10

# Audio & Storage
STORAGE_DIR=./storage
AUDIO_RETENTION_DAYS=30
MAX_AUDIO_SIZE_MB=25

# Demonstration / Offline Mode
ALLOW_OFFLINE_FALLBACK=True
